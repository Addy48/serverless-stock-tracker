# AWS — IAM user with dynamodb PutItem/Query and sns:Publish only
AWS_ACCESS_KEY_ID=your_iam_access_key_here
AWS_SECRET_ACCESS_KEY=your_iam_secret_key_here
AWS_REGION=us-east-1

# Alpha Vantage — https://www.alphavantage.co/support/#api-key
# Free tier is rate-limited; keep the watchlist short.
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

TABLE_NAME=stock_ohlc
RETENTION_DAYS=90

# From Terraform output after apply
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:stock-price-alerts

WATCHLIST_JSON=[{"symbol":"AAPL","upper":230,"lower":180},{"symbol":"MSFT","upper":450,"lower":350}]
